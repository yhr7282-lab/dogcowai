      "items": [
        {
          "id": "peak-energy-series-b-2026",
          "date": "2026-10-21",
          "featured": true,
          "status": "보완",
          "basis": "공장 생산은 계획",
          "title": "Peak Energy, 나트륨이온 ESS 확대에 1억800만달러 조달",
          "teaser": "투자 유치는 마쳤고, 공장 생산은 2027년 1분기 목표다.",
          "facts": "미국 Peak Energy는 21일 GM Ventures가 주도한 시리즈 B 투자로 1억800만달러를 조달했다고 발표했다. 나트륨이온 에너지저장장치(ESS)의 미국 생산 확대와 데이터센터 시장 진출에 자금을 쓸 계획이다. 캘리포니아 새크라멘토의 생산능력 4GWh 공장은 2027년 1분기 생산 시작이 목표다.",
          "so": "리튬이온이 아닌 저장 기술이 생산 확대 자금을 확보한 경우다. 경제성과 신뢰성은 양산과 납품 실적이 쌓여야 판단할 수 있다.",
          "recheck": {
            "label": "다시 볼 조건",
            "text": "2027년 1분기 생산 개시 목표의 이행 여부가 다음 변수다."
          },
          "sources": [
            {
              "name": "Peak Energy 공식 발표",
              "url": "https://peakenergy.com/news/latest/peak-raises-108-million-series-b"
            }
          ]
        },
        {
          "id": "sm-kukil-daejin-preferred-bidder",
          "date": "2026-10-23",
          "status": "보완",
          "basis": "우선협상 단계",
          "title": "SM국일, 배터리·반도체 장비사 대진기계 인수 우선협상대상자 선정",
          "teaser": "우선협상대상자 선정이며 인수 계약 체결은 아직이다.",
          "facts": "SM그룹 계열사 SM국일(옛 국일제지)은 2차전지·반도체 생산장비 기업 대진기계 인수를 위한 우선협상대상자로 선정됐다고 23일 밝혔다. 대진기계는 배터리 모듈·팩 조립 자동화설비와 반도체 웨이퍼용 잉곳 성장기 등을 만들어 왔고, ESS용 배터리 생산장비 관련 매출이 전체의 약 70%라고 연합뉴스는 전했다.",
          "so": "제지 위주였던 사업을 산업장비로 넓히려는 행보다.",
          "recheck": {
            "label": "다시 볼 조건",
            "text": "최종 계약 체결 여부와 인수가격·자금 조달 방안이 다음 단계다."
          },
          "sources": [
            {
              "name": "연합뉴스",
              "url": "https://www.yna.co.kr/amp/view/AKR20261023035700003"
            }
          ]
        }
      ]
