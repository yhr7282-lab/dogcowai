      "items": [
        {
          "id": "kim-jong-un-dandong-wang-huning-2026-oct",
          "date": "2026-10-24",
          "featured": true,
          "status": "진전",
          "basis": "중국 관영매체 발표",
          "title": "중국 신화통신, 김정은 단둥 방문·왕후닝 면담 공식 보도",
          "teaser": "왕후닝 정협 주석이 시진핑 주석의 인사를 전했다.",
          "facts": "중국 관영 신화통신은 김정은 북한 국무위원장이 24일 랴오닝성 단둥을 방문해 왕후닝 중국 인민정치협상회의 전국위원회 주석과 만났다고 보도했다. 왕 주석은 시진핑 국가주석의 인사와 축원을 전하고, 신압록강대교 개통을 계기로 인적 교류와 무역 협력을 넓힐 수 있다고 말했다. 김 위원장은 항미원조 기념탑에 꽃바구니를 바쳤고 오후에는 단둥의 자동차 공장을 둘러봤다. 왕 주석은 김 위원장이 단둥을 떠날 때 신압록강대교에서 배웅했다.",
          "so": "전날 한국 정부 소식통을 통해 알려진 김 위원장의 방중이 중국 관영매체 발표로 공식화됐다. 신화통신 보도에는 시진핑 주석과의 회담이나 구체적인 계약·교역 규모가 나오지 않았다.",
          "recheck": {
            "text": "북한 관영매체가 방문 결과를 어떻게 발표할지, 신압록강대교를 통한 교역이 실제로 늘어날지가 변수다."
          },
          "follows": {
            "date": "2026-10-24",
            "id": "kim-jong-un-china-visit-2026-oct"
          },
          "sources": [
            {
              "name": "신화통신",
              "url": "https://english.news.cn/20261025/b655718a49204a18996f3d8b843a9925/c.html"
            }
          ]
        },
        {
          "id": "jordan-church-attack-toll-9-2026-oct",
          "date": "2026-10-24",
          "status": "진전",
          "basis": "수사 중",
          "title": "요르단 카라크 교회 총격 사망자 9명으로 늘어",
          "teaser": "부상자가 잇따라 숨지며 사망자가 늘었고, 배후는 아직 드러나지 않았다.",
          "facts": "요르단 공공안전국은 24일 카라크주 교회 총격으로 다친 1명이 더 숨져 사망자가 9명으로 늘었다고 국영 페트라통신을 통해 밝혔다. AP통신은 공격 이튿날인 24일 사망자가 9명으로 늘었고 부상자는 40명 가까이 된다고 보도했다.",
          "so": "23일 공격 당일 당국이 발표한 사망자는 7명이었고, 이후 부상자 2명이 차례로 숨졌다. AP에 따르면 공격 동기는 밝혀지지 않았고, 배후를 자처하거나 지목된 무장단체도 없다.",
          "recheck": {
            "text": "범인 검거와 수사 당국의 동기·배후 발표가 수사의 다음 단계다."
          },
          "follows": {
            "date": "2026-10-24",
            "id": "jordan-church-attack-2026-oct"
          },
          "sources": [
            {
              "name": "페트라통신",
              "url": "https://petra.gov.jo/en/news/death-toll-in-karak-church-terrorist-attack-rises-to-9"
            },
            {
              "name": "WRAL (AP)",
              "url": "https://www.wral.com/news/ap/09d5d-survivor-of-deadly-attack-on-jordan-church-describes-people-crawling-for-their-lives/"
            }
          ]
        },
        {
          "id": "france-nationwide-protests-2026-oct-24",
          "date": "2026-10-24",
          "status": "신규",
          "title": "프랑스 전국 시위에 41만 명 참가, 1,000명 가까이 체포",
          "teaser": "정부 집계와 주최 측 추산이 두 배 가까이 엇갈렸다.",
          "facts": "프랑스 내무부는 24일 전국 시위 참가자를 41만 명, 이 가운데 파리 참가자를 11만 명으로 집계했다. 로랑 뉘네즈 내무장관은 시위 과정에서 1,000명 가까이 체포됐으며 이 숫자가 더 늘어날 것이라고 말했다. 시위를 주최한 노조는 전국 80만 명, 파리 25만 명이 참가했다고 주장했다.",
          "so": "알자지라에 따르면 이번 시위는 9월 중순 고등학생들이 낡은 학교 건물과 교사 부족에 항의해 학교를 봉쇄하면서 시작됐고, 이번에는 구매력과 공공서비스 문제를 내걸었다. 파리에서는 경찰이 최루가스와 물대포를 썼고 마르세유와 리옹에서도 충돌이 있었다.",
          "recheck": {
            "text": "정부가 교육·생활비 대책을 내놓을지와 체포자 처리 결과가 다음 시위의 변수다."
          },
          "sources": [
            {
              "name": "France 24",
              "url": "https://www.france24.com/en/france/20261024-live-hundreds-of-protests-expected-in-france-amid-high-tensions-and-heavy-police-presence"
            },
            {
              "name": "Al Jazeera",
              "url": "https://www.aljazeera.com/news/2026/10/24/france-braces-for-another-day-of-mass-protests-as-security-on-high-alert"
            }
          ]
        },
        {
          "id": "italy-nationwide-protests-2026-oct-24",
          "date": "2026-10-24",
          "status": "신규",
          "basis": "단일 보도",
          "title": "이탈리아 주요 도시 반전·생활비 시위, 로마·토리노서 경찰과 충돌",
          "teaser": "전쟁과 재무장, 생활비 상승에 반대하는 시위가 삼엄한 경비 속에 열렸다.",
          "facts": "이탈리아 로마·토리노·볼로냐 등 주요 도시에서 24일 전쟁과 재무장, 높은 생활비에 반대하는 시위가 열렸고 일부 도시에서 경찰과 충돌했다고 일솔레24오레가 보도했다. 로마에서는 경찰이 물대포와 최루가스를 썼고, 토리노에서는 시위대가 경찰에 돌과 병을 던졌다. 볼로냐에서는 시위대가 바리케이드를 쌓고 쓰레기통에 불을 질렀다.",
          "so": "시위는 지난 17일 밀라노 등에서 폭력 사태가 벌어진 뒤 삼엄한 경비 속에 열렸다. 로마 경찰은 복면 등을 지닌 젊은이 43명을 경찰서로 데려갔다.",
          "recheck": {
            "text": "전국 체포·부상자 공식 집계와 추가 시위 일정이 다음 관심사다."
          },
          "sources": [
            {
              "name": "일솔레24오레",
